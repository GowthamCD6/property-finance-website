// Prisma schema for Property Loan Consultancy Website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SiteContent {
  id                   String   @id @default("default_content")
  businessName         String   @default("Prime Associates — Loans & Constructions")
  tagline              String?  @default("Your Trusted Property Finance & Loan Advisory Partner")
  businessPhone        String   @default("+91 96555 66613, +91 95144 66600")
  businessEmail        String   @default("primeassociates2008@gmail.com")
  officeAddress        String   @default("No. 48, 49, P.R. Complex, Binny Compound Main Street, Kumaran Road, Tirupur - 641601")
  cityState            String   @default("Tirupur, Tamil Nadu, India")
  businessHours        String   @default("Monday – Saturday: 9:30 AM – 6:30 PM (IST)")
  
  // Header & Floating
  announcementText     String?  @default("Special Home Loan Rates starting from 7.25% p.a. • Government Subsidy Assistance Available")
  announcementActive   Boolean  @default(true)
  announcementLink     String?  @default("/services/home-loans")
  whatsappNumber       String?  @default("+919655566613")
  whatsappMessage      String?  @default("Hello Prime Associates, I would like to enquire about a property loan.")
  socialLinks          String?  // JSON: { facebook, instagram, linkedin, twitter, youtube, mapUrl }
  registrationDetails  String?  @default("GSTIN: 33ABCDE1234F1Z5 • Authorized Property Loan Facilitator & Direct Syndication Partner")

  // Homepage Hero
  heroEyebrow          String   @default("PRIME ASSOCIATES • LOANS & CONSTRUCTIONS")
  heroHeadline         String   @default("Get Your Home & Mortgage Loans at Lowest Rates with Government Subsidy.")
  heroRotatingWords    String?  @default("Lowest Rates.,Govt. Subsidy.,7.25% Home Loans.,8.50% LAP.,Bank Takeover.")
  heroSubtitle         String   @default("Expert loan facilitation across Government and Private Banks. Home Loans from 7.25% p.a., Mortgage Loans (LAP) from 8.50% p.a., Purchase Loans, Vehicle Loans, and Private-to-Government Bank Takeovers.")
  heroCtaText          String   @default("Discuss Your Loan")
  heroSecondaryCtaText String   @default("Explore Loan Options")
  heroImageUrl         String   @default("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80")
  heroBadges           String?  // JSON array of string tags
  
  // Stats Counters
  statsCapital         String?  @default("120")
  statsCapitalSuffix   String?  @default("Cr+")
  statsCapitalLabel    String?  @default("Capital Facilitated")
  statsLenders         String?  @default("40")
  statsLendersSuffix   String?  @default("+")
  statsLendersLabel    String?  @default("Partner Banks & NBFCs")
  statsSanction        String?  @default("98.4")
  statsSanctionSuffix  String?  @default("%")
  statsSanctionLabel   String?  @default("Sanction Success Rate")
  statsTurnaround      String?  @default("24")
  statsTurnaroundSuffix String? @default("Hours")
  statsTurnaroundLabel String?  @default("Turnaround Time")

  // Multi-Lender Rate Comparison Matrix
  rateMatrix           String?  // JSON array of { id, bankName, homeLoanRate, lapRate, maxTenure, processingFee, ltv, popularTag }

  // Why Choose Us
  whyChooseUsTitle     String?  @default("Why Property Owners & Investors Choose Prime Associates")
  whyChooseUsSubtitle  String?  @default("We combine decades of on-ground property experience with institutional banking relationships.")
  whyChooseUsPillars   String?  // JSON array of { title, description, metric, icon }

  // Process Steps
  processTitle         String?  @default("End-to-End Loan Facilitation Process")
  processSubtitle      String?  @default("From eligibility review to final bank disbursement, our consultants manage each phase.")
  processSteps         String?  // JSON array of { stepNumber, title, description, turnaround }

  // Document Checklist
  salariedDocs         String?  // JSON array of string items
  selfEmployedDocs     String?  // JSON array of string items
  propertyDocs         String?  // JSON array of string items

  // Client Testimonials
  testimonials         String?  // JSON array of { id, name, location, loanType, amount, review, rating, avatarUrl }

  // About Page
  aboutHeading         String   @default("Dedicated Property Loan Consultancy with Transparent Guidance")
  aboutText            String   @default("We assist property owners, buyers, and business professionals in navigating the loan evaluation process. Our focus is helping you understand eligibility guidelines, assemble required documentation, and connect with reputable lending institutions suited to your profile.")
  aboutImageUrl        String   @default("https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1000&q=80")
  aboutMission         String?  @default("To empower property owners, homebuyers, and entrepreneurs with transparent, optimal debt financing by navigating complex banking criteria with integrity, speed, and institutional precision.")
  aboutVision          String?  @default("To become Tamil Nadu's most trusted and technologically advanced property finance advisory, recognized for zero upfront commissions and exceptional client outcomes.")
  aboutMilestones      String?  // JSON array of { year, title, description, stat }
  aboutTeam            String?  // JSON array of { id, name, role, experience, bio, imageUrl, linkedinUrl }
  aboutPillars         String?  // JSON array of { title, desc, icon }

  // Contact Page & Branches
  contactHeroTitle     String?  @default("Connect with Our Advisory Team")
  contactHeroSubtitle  String?  @default("Schedule a confidential one-on-one consultation at our Tirupur office or request an instant phone evaluation.")
  contactHeroImageUrl  String?  @default("https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80")
  branchOffices        String?  // JSON array of { name, address, phone, email, timings, mapEmbedUrl }

  // Calculator Parameters
  calcDefaultHomeRate  Float?   @default(7.25)
  calcDefaultLapRate   Float?   @default(8.50)
  calcDefaultAmount    Float?   @default(5000000)
  calcDefaultTenure    Int?     @default(20)

  // Legal & Regulatory
  disclaimerText       String   @default("Prime Associates (Prime Associate Loans) is an independent loan consultancy and loan facilitation service. We are not a bank, NBFC, or direct credit lender. Loan sanctions, interest rates, valuation, eligibility, and disbursements are strictly at the sole discretion of the partner banks and lending institutions following their regulatory underwriting criteria.")
  privacyPolicy        String   @default("We respect your confidentiality. The personal, financial, and property details shared in this enquiry are solely used for eligibility assessment and arranging consultation. We do not sell or distribute your data to unauthorized third parties.")
  termsConditions      String   @default("Information provided on this website is for informational and consultation scheduling purposes only and does not constitute a formal financial commitment or binding loan offer.")
  copyrightText        String   @default("Prime Associates — Loans & Constructions. All rights reserved.")
  
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  fullDescription  String
  iconName         String   @default("Home")
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  enquiries        Enquiry[]
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Enquiry {
  id                     String          @id @default(cuid())
  referenceNumber        String          @unique
  fullName               String
  mobileNumber           String
  email                  String?
  preferredContactMethod String          @default("phone") // phone, email, whatsapp
  cityState              String
  
  loanType               String          // Home Loan, Loan Against Property, etc.
  serviceId              String?
  service                Service?        @relation(fields: [serviceId], references: [id])
  
  loanAmount             Float           // Stored as numeric amount in INR
  propertyType           String          // residential, commercial, land, other
  propertyLocation       String
  propertyOwnershipStatus String         // owned, jointly_owned, purchasing, other
  employmentType         String          // salaried, self_employed, business_owner, other
  
  preferredDate          String          // YYYY-MM-DD
  preferredTimeSlot      String          // e.g. 10:00 AM - 11:00 AM
  meetingMode            String          @default("phone") // phone, video, in_person
  additionalNotes        String?
  
  status                 String          @default("New") 
  // Statuses: New, Contacted, Follow-up Required, Appointment Requested, Appointment Confirmed, In Review, Converted, Closed
  consentGiven           Boolean         @default(false)
  
  appointments           Appointment[]
  notes                  EnquiryNote[]
  statusHistory          StatusHistory[]
  
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Appointment {
  id                 String    @id @default(cuid())
  enquiryId          String
  enquiry            Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  
  date               String    // YYYY-MM-DD
  timeSlot           String    // e.g. 10:00 AM - 11:00 AM
  timezone           String    @default("Asia/Kolkata")
  meetingMode        String    @default("phone")
  status             String    @default("Requested") // Requested, Confirmed, Rescheduled, Cancelled, Completed
  
  rescheduleReason   String?
  cancellationReason String?
  adminNotes         String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([date, timeSlot])
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorName String   @default("Consultant")
  content    String
  createdAt  DateTime @default(now())
}

model StatusHistory {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String   @default("System")
  note       String?
  createdAt  DateTime @default(now())
}

model AvailabilityConfig {
  id                  String   @id @default(cuid())
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  dayName             String   // "Monday", "Tuesday", etc.
  startTime           String   @default("10:00") // HH:mm
  endTime             String   @default("18:00") // HH:mm
  slotDurationMinutes Int      @default(60)
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  reason    String   @default("Holiday")
  createdAt DateTime @default(now())
}
