// Prisma schema for Property Loan Consultancy Website (MySQL / TiDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin")
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CustomerUser {
  id           String    @id @default(cuid())
  googleId     String?   @unique
  email        String    @unique
  name         String
  picture      String?   @db.Text
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  enquiries    Enquiry[]
}

model SiteContent {
  id                   String   @id @default("default_content")
  businessName         String   @default("Prime Associates — Loans & Constructions")
  tagline              String?  @default("Your Trusted Property Finance & Loan Advisory Partner")
  businessPhone        String   @default("+91 96555 66613, +91 95144 66600")
  businessEmail        String   @default("primeassociates2008@gmail.com")
  officeAddress        String?  @db.Text
  cityState            String   @default("Tirupur, Tamil Nadu, India")
  businessHours        String   @default("Monday – Saturday: 9:30 AM – 6:30 PM (IST)")
  
  // Header & Floating
  announcementText     String?  @db.Text
  announcementActive   Boolean  @default(true)
  announcementLink     String?
  whatsappNumber       String?  @default("+919655566613")
  whatsappMessage      String?  @db.Text
  socialLinks          String?  @db.LongText // JSON: { facebook, instagram, linkedin, twitter, youtube, mapUrl }
  registrationDetails  String?  @db.Text
  
  // Homepage Hero
  heroEyebrow          String   @default("PRIME ASSOCIATES • LOANS & CONSTRUCTIONS")
  heroHeadline         String   @default("Get Your Home & Mortgage Loans at Lowest Rates with Government Subsidy.")
  heroRotatingWords    String?  @db.Text
  heroSubtitle         String?  @db.Text
  heroCtaText          String   @default("Discuss Your Loan")
  heroSecondaryCtaText String   @default("Explore Loan Options")
  heroImageUrl         String?  @db.Text
  heroBadges           String?  @db.LongText // JSON array of string tags
  
  // Stats Counters
  statsCapital         String?  @default("120")
  statsCapitalSuffix   String?  @default("Cr+")
  statsCapitalLabel    String?  @default("Capital Facilitated")
  statsLenders         String?  @default("40")
  statsLendersSuffix   String?  @default("+")
  statsLendersLabel    String?  @default("Partner Banks & NBFCs")
  statsSanction        String?  @default("98.4")
  statsSanctionSuffix  String?  @default("%")
  statsSanctionLabel   String?  @default("Sanction Success Rate")
  statsTurnaround      String?  @default("24")
  statsTurnaroundSuffix String? @default("Hours")
  statsTurnaroundLabel String?  @default("Turnaround Time")

  // Multi-Lender Rate Comparison Matrix
  rateMatrix           String?  @db.LongText // JSON array of { id, bankName, homeLoanRate, lapRate, maxTenure, processingFee, ltv, popularTag }

  // Why Choose Us
  whyChooseUsTitle     String?  @default("Why Property Owners & Investors Choose Prime Associates")
  whyChooseUsSubtitle  String?  @db.Text
  whyChooseUsPillars   String?  @db.LongText // JSON array of { title, description, metric, icon }

  // Process Steps
  processTitle         String?  @default("End-to-End Loan Facilitation Process")
  processSubtitle      String?  @db.Text
  processSteps         String?  @db.LongText // JSON array of { stepNumber, title, description, turnaround }

  // Document Checklist
  salariedDocs         String?  @db.LongText // JSON array of string items
  selfEmployedDocs     String?  @db.LongText // JSON array of string items
  propertyDocs         String?  @db.LongText // JSON array of string items

  // Client Testimonials
  testimonials         String?  @db.LongText // JSON array of { id, name, location, loanType, amount, review, rating, avatarUrl }

  // About Page
  aboutHeading         String   @default("Dedicated Property Loan Consultancy with Transparent Guidance")
  aboutText            String?  @db.LongText
  aboutImageUrl        String?  @db.Text
  aboutMission         String?  @db.LongText
  aboutVision          String?  @db.LongText
  aboutMilestones      String?  @db.LongText // JSON array of { year, title, description, stat }
  aboutTeam            String?  @db.LongText // JSON array of { id, name, role, experience, bio, imageUrl, linkedinUrl }
  aboutPillars         String?  @db.LongText // JSON array of { title, desc, icon }

  // Contact Page & Branches
  contactHeroTitle     String?  @default("Connect with Our Advisory Team")
  contactHeroSubtitle  String?  @db.Text
  contactHeroImageUrl  String?  @db.Text
  branchOffices        String?  @db.LongText // JSON array of { name, address, phone, email, timings, mapEmbedUrl }

  // Calculator Parameters
  calcDefaultHomeRate  Float?   @default(7.25)
  calcDefaultLapRate   Float?   @default(8.50)
  calcDefaultAmount    Float?   @default(5000000)
  calcDefaultTenure    Int?     @default(20)

  // Legal & Regulatory
  disclaimerText       String?  @db.LongText
  privacyPolicy        String?  @db.LongText
  termsConditions      String?  @db.LongText
  copyrightText        String   @default("Prime Associates — Loans & Constructions. All rights reserved.")
  
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String   @db.Text
  fullDescription  String   @db.LongText
  iconName         String   @default("Home")
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  enquiries        Enquiry[]
}

model Faq {
  id           String   @id @default(cuid())
  question     String   @db.Text
  answer       String   @db.Text
  category     String   @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Enquiry {
  id                     String          @id @default(cuid())
  referenceNumber        String          @unique
  fullName               String
  mobileNumber           String
  email                  String?
  preferredContactMethod String          @default("phone") // phone, email, whatsapp
  cityState              String
  
  customerId             String?
  customer               CustomerUser?   @relation(fields: [customerId], references: [id])
  
  loanType               String          // Home Loan, Loan Against Property, etc.
  serviceId              String?
  service                Service?        @relation(fields: [serviceId], references: [id])
  
  loanAmount             Float           // Stored as numeric amount in INR
  propertyType           String          // residential, commercial, land, other
  propertyLocation       String
  propertyOwnershipStatus String         // owned, jointly_owned, purchasing, other
  employmentType         String          // salaried, self_employed, business_owner, other
  
  preferredDate          String          // YYYY-MM-DD
  preferredTimeSlot      String          // e.g. 10:00 AM - 11:00 AM
  meetingMode            String          @default("phone") // phone, video, in_person
  additionalNotes        String?         @db.Text
  
  status                 String          @default("New") 
  consentGiven           Boolean         @default(false)
  
  appointments           Appointment[]
  notes                  EnquiryNote[]
  statusHistory          StatusHistory[]
  
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Appointment {
  id                 String    @id @default(cuid())
  enquiryId          String
  enquiry            Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  
  date               String    // YYYY-MM-DD
  timeSlot           String    // e.g. 10:00 AM - 11:00 AM
  timezone           String    @default("Asia/Kolkata")
  meetingMode        String    @default("phone")
  status             String    @default("Requested") // Requested, Confirmed, Rescheduled, Cancelled, Completed
  
  rescheduleReason   String?   @db.Text
  cancellationReason String?   @db.Text
  adminNotes         String?   @db.Text
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([date, timeSlot])
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorName String   @default("Consultant")
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

model StatusHistory {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String   @default("System")
  note       String?  @db.Text
  createdAt  DateTime @default(now())
}

model AvailabilityConfig {
  id                  String   @id @default(cuid())
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  dayName             String   // "Monday", "Tuesday", etc.
  startTime           String   @default("10:00") // HH:mm
  endTime             String   @default("18:00") // HH:mm
  slotDurationMinutes Int      @default(60)
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  reason    String   @default("Holiday")
  createdAt DateTime @default(now())
}
