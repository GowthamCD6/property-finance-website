# ==============================================================================
# PRIME ASSOCIATES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata
ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 2. TIDB CLOUD DATABASE (DISTRIBUTED MYSQL ENGINE)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict&sslca=certs/isrgrootx1.pem
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://username.root:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/prime_associates?sslaccept=strict&sslca=certs/isrgrootx1.pem"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-signing-key
ADMIN_API_KEY=your-corporate-admin-api-key

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (SINGLE SIGN-ON)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. CLOUDINARY SECURE DOCUMENT VAULT
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
