# ==============================================================================
# PRIME ASSOCIATES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata
ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 2. TIDB CLOUD DISTRIBUTED DATABASE PARAMETERS
# ------------------------------------------------------------------------------
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_cluster_username.root
TIDB_PASSWORD=your_cluster_password
TIDB_DATABASE=prime_associates
TIDB_SSL_CA=certs/isrgrootx1.pem

# Prisma ORM Connection String (assembled from parameters above)
DATABASE_URL="mysql://${TIDB_USER}:${TIDB_PASSWORD}@${TIDB_HOST}:${TIDB_PORT}/${TIDB_DATABASE}?sslaccept=strict&sslca=${TIDB_SSL_CA}"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-signing-key
ADMIN_API_KEY=your-corporate-admin-api-key

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (SINGLE SIGN-ON)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. CLOUDINARY SECURE DOCUMENT VAULT
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
