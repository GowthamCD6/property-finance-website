# ==============================================================================
# PRIME ASSOCIATES — CLIENT ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file to '.env' and fill in your values.
# ==============================================================================
# Set to /api when using local Vite proxy or unified deployment.
# For cross-origin production deployment (e.g. Render backend): VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ADMIN_API_KEY=your-corporate-admin-api-key
